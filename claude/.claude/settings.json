{
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
